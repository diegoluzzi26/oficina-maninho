# ---------- Aplicação ----------
NODE_ENV=development
PORT=3000
API_PORT=3000
WEB_PORT=8080

# ---------- Banco ----------
POSTGRES_USER=oficina
# Troque em produção. Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=oficina
DB_PORT=5432
# Rodando pelo Docker Compose, o host é "db". Fora dele, use localhost.
DATABASE_URL=postgres://oficina:troque-esta-senha@localhost:5432/oficina

# ---------- Autenticação ----------
# OBRIGATÓRIO trocar. Gere com: openssl rand -base64 32
JWT_SECRET=troque-esta-chave-obrigatoriamente
JWT_EXPIRES_IN=8h

# ---------- WhatsApp (Evolution API — self-hosted via Baileys) ----------
# URL que o backend usa pra falar com a Evolution.
EVOLUTION_URL=http://evolution:8080
# OBRIGATÓRIO gerar. Chave global do Evolution.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex').toUpperCase())"
EVOLUTION_API_KEY=troque-esta-chave-de-evolution
# Nome da instância WhatsApp que aparece no phone-linking.
EVOLUTION_INSTANCE=oficina
# Porta do Evolution exposta pro host (interface admin em http://localhost:8081)
EVOLUTION_PORT=8081

# ---------- Alertas de vencimento ----------
# Seu WhatsApp em E.164 (ex: +5551998887777), para receber avisos de boletos
# a vencer. Sem isso, os alertas ficam só no sistema.
ALERTA_WHATSAPP=
ALERTA_HORA=8

# ---------- Backup diário do banco ----------
BACKUP_HORA=3
RCLONE_REMOTE=drive
RCLONE_PASTA=oficina-backups
