# ---------- Aplicação ----------
NODE_ENV=development
PORT=3000
API_PORT=3000
WEB_PORT=8080

# ---------- Banco ----------
POSTGRES_USER=oficina
# Troque em produção. Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=oficina
DB_PORT=5432
# Rodando pelo Docker Compose, o host é "db". Fora dele, use localhost.
DATABASE_URL=postgres://oficina:troque-esta-senha@localhost:5432/oficina

# ---------- Autenticação ----------
# OBRIGATÓRIO trocar. Gere com: openssl rand -base64 32
JWT_SECRET=troque-esta-chave-obrigatoriamente
JWT_EXPIRES_IN=8h

# ---------- WhatsApp (Meta Cloud API) ----------
# Token permanente do App (System User). O token de teste expira em 24h.
WHATSAPP_TOKEN=
# ID do número remetente (Meta > WhatsApp > API Setup)
PHONE_NUMBER_ID=
# String que VOCÊ inventa; a Meta a devolve ao validar o webhook
VERIFY_TOKEN=escolha-uma-frase-secreta
# ID da conta WhatsApp Business
WABA_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_LANG=pt_BR

# Nomes dos templates aprovados na Meta
WHATSAPP_TEMPLATE_ABERTURA=os_aberta
WHATSAPP_TEMPLATE_FINALIZADA=os_finalizada
WHATSAPP_TEMPLATE_PAGA=os_paga
WHATSAPP_TEMPLATE_RETORNO=retorno_agendado
WHATSAPP_TEMPLATE_LEMBRETE=lembrete_agendamento

# ---------- Alertas de vencimento ----------
# Seu WhatsApp em E.164, para receber avisos de boletos a vencer.
# Ex.: +5551998887777. Sem isso, os alertas ficam só no sistema.
ALERTA_WHATSAPP=
# Hora do dia (0-23) em que a verificação diária roda
ALERTA_HORA=8
WHATSAPP_TEMPLATE_ALERTA=alerta_contas

# ---------- Backup diário do banco ----------
# Hora do dia (0-23) em que o pg_dump é feito. Recomendo madrugada.
BACKUP_HORA=3
# Nome do remote configurado no rclone. Padrão "drive".
RCLONE_REMOTE=drive
# Pasta destino no Google Drive
RCLONE_PASTA=oficina-backups
